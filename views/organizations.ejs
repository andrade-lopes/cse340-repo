<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section>
            <h2>Community Organizations</h2>

            <p>Learn more about organizations serving our community.</p>

            <ul>
                <% organizations.forEach(organization=> { %>
                    <li>
                        <img class="organization-logo" src="/images/<%= organization.logo_filename %>"
                            alt="<%= organization.name %> logo">

                        <strong>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </strong>

                        <p>
                            <%= organization.description %>
                        </p>

                        <p>
                            <%= organization.contact_email %>
                        </p>
                    </li>
                    <% }); %>
            </ul>
        </section>
    </main>

    <%- include('partials/footer') %>